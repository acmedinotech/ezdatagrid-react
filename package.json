{
  "name": "@acmedinotech/ezdatagrid-react",
  "version": "0.1.2",
  "description": "A lightweight, fast, and flexible dynamic datagrid display & editor for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/ezdatagrid-react.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "./scripts/publish.sh"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "react",
    "datagrid",
    "table",
    "editor",
    "crud",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
